package kawi:plugin@0.8.0;

interface types {
  record position {
    line: u32,
    byte-column: u32,
  }

  record selection {
    start: position,
    end: position,
  }

  record buffer-info {
    buffer: u64,
    revision: u64,
    path: option<string>,
    language: option<string>,
    modified: bool,
  }

  record buffer-state {
    buffer: u64,
    revision: u64,
    path: option<string>,
    language: option<string>,
    modified: bool,
    text: option<string>,
  }

  record window-info {
    window: u64,
    buffer: u64,
    active: bool,
    width: u32,
    height: u32,
  }

  enum split-direction {
    horizontal,
    vertical,
  }

  enum option-kind {
    boolean,
    integer,
    text,
    enumeration,
    list-values,
  }

  enum option-scope {
    global,
    buffer,
    window,
  }

  record option-info {
    name: string,
    aliases: list<string>,
    description: string,
    kind: option-kind,
    scope: option-scope,
    section: string,
    default: string,
    value: string,
    values: list<string>,
  }

  record state {
    buffer: u64,
    revision: u64,
    path: option<string>,
    language: option<string>,
    mode: string,
    cursor: position,
    selection: option<selection>,
    text: option<string>,
  }

  record edit {
    start: position,
    end: position,
    text: string,
  }

  enum severity {
    error,
    warning,
    information,
    hint,
  }

  record diagnostic {
    start: position,
    end: position,
    severity: severity,
    message: string,
    source: option<string>,
    code: option<string>,
  }

  enum decoration-style {
    accent,
    info,
    success,
    warning,
    error,
    muted,
  }

  record highlight {
    start: position,
    end: position,
    group: string,
  }

  record virtual-text {
    line: u32,
    text: string,
    group: string,
  }

  variant decoration {
    highlight(highlight),
    virtual-text(virtual-text),
  }

  record error {
    code: s32,
    message: string,
    capability: option<string>,
  }

  record command-info {
    id: string,
    description: string,
    aliases: list<string>,
  }

  variant setting-value {
    boolean(bool),
    integer(s64),
    float(f64),
    text(string),
  }

  record setting {
    key: string,
    value: setting-value,
  }

  variant argument {
    null,
    boolean(bool),
    integer(s64),
    float(f64),
    text(string),
  }

  record process-output {
    success: bool,
    code: option<s32>,
    stdout: string,
    stderr: string,
  }

  record buffer-changed {
    buffer: u64,
    revision: u64,
    previous-revision: u64,
    origin: string,
    full-resync: bool,
    changes: list<edit>,
  }

  record buffer-opened {
    buffer: u64,
    path: option<string>,
    language: option<string>,
    revision: u64,
  }

  record file-opened {
    buffer: u64,
    path: string,
    language: option<string>,
    revision: u64,
  }

  record buffer-closed {
    buffer: u64,
    path: option<string>,
  }

  record file-saved {
    buffer: u64,
    path: option<string>,
    revision: u64,
  }

  record mode-changed {
    buffer: u64,
    previous: string,
    next: string,
  }

  record diagnostics-changed {
    buffer: option<u64>,
    path: string,
    revision: u64,
    diagnostics: list<diagnostic>,
  }

  record buffer-enter {
    buffer: u64,
    path: option<string>,
    language: option<string>,
    revision: u64,
  }

  record buffer-leave {
    buffer: u64,
    path: option<string>,
  }

  record window-enter {
    window: u64,
    buffer: u64,
  }

  record window-leave {
    window: u64,
    buffer: u64,
  }

  record cursor-moved {
    buffer: u64,
    cursor: position,
    selection: option<selection>,
  }

  record selection-changed {
    buffer: u64,
    selection: option<selection>,
  }

  record focus-changed {
    window: u64,
    buffer: u64,
  }

  variant prompt-outcome {
    text(string),
    selected(string),
    confirmed(bool),
    canceled,
  }

  variant event {
    buffer-changed(buffer-changed),
    buffer-opened(buffer-opened),
    file-opened(file-opened),
    buffer-closed(buffer-closed),
    file-saved(file-saved),
    mode-changed(mode-changed),
    diagnostics-changed(diagnostics-changed),
    buffer-enter(buffer-enter),
    buffer-leave(buffer-leave),
    window-enter(window-enter),
    window-leave(window-leave),
    cursor-moved(cursor-moved),
    selection-changed(selection-changed),
    focus-gained(focus-changed),
    focus-lost(focus-changed),
  }
}

interface editor-read {
  use types.{state, error};
  get-state: func(include-text: bool) -> result<state, error>;
}

interface editor-write {
  use types.{edit, error};
  apply-edit: func(buffer: u64, revision: u64, edits: list<edit>) -> result<u64, error>;
}

interface editor-execute {
  use types.{command-info, error};
  execute: func(command: string) -> result<_, error>;
  list-commands: func() -> result<list<command-info>, error>;
}

interface editor-buffers {
  use types.{buffer-info, buffer-state, error};
  list-buffers: func() -> result<list<buffer-info>, error>;
  get: func(buffer: u64, include-text: bool) -> result<buffer-state, error>;
}

interface editor-buffers-write {
  use types.{buffer-state, edit, error};
  open: func(path: string) -> result<buffer-state, error>;
  apply-edit: func(buffer: u64, revision: u64, edits: list<edit>) -> result<u64, error>;
}

interface editor-windows {
  use types.{split-direction, window-info, error};
  list-windows: func() -> result<list<window-info>, error>;
  get: func(window: u64) -> result<window-info, error>;
  focus: func(window: u64) -> result<window-info, error>;
  open: func(buffer: u64, direction: split-direction) -> result<window-info, error>;
  close: func(window: u64, force: bool) -> result<window-info, error>;
}

interface editor-control {
  use types.{position, selection, state, error};
  set-cursor: func(buffer: u64, cursor: position) -> result<state, error>;
  set-selection: func(buffer: u64, selection: option<selection>) -> result<state, error>;
  set-mode: func(buffer: u64, mode: string) -> result<state, error>;
}

interface options-read {
  use types.{option-info, error};
  list-options: func(prefix: option<string>) -> result<list<option-info>, error>;
  get: func(name: string) -> result<option-info, error>;
}

interface config-read {
  use types.{error, setting, setting-value};
  get: func(key: string) -> result<option<setting-value>, error>;
  get-all: func() -> result<list<setting>, error>;
}

interface ui-message {
  use types.{error};
  message: func(text: string) -> result<_, error>;
}

interface ui-prompt {
  use types.{error, prompt-outcome};
  input: func(title: string, placeholder: option<string>, value: option<string>, max-length: option<u32>) -> result<prompt-outcome, error>;
  select: func(title: string, options: list<string>, selected: option<u32>) -> result<prompt-outcome, error>;
  confirm: func(title: string, message: option<string>) -> result<prompt-outcome, error>;
}

interface ui-progress {
  use types.{error};
  start: func(title: string, message: option<string>, fraction: option<f32>) -> result<u64, error>;
  update: func(id: u64, message: option<string>, fraction: option<f32>) -> result<bool, error>;
  finish: func(id: u64) -> result<_, error>;
}

interface ui-panel {
  use types.{decoration-style, error};

  record panel-line {
    text: string,
    style: option<decoration-style>,
  }

  record open-params {
    title: string,
    status: option<string>,
    height: option<u32>,
    focus: bool,
    lines: list<panel-line>,
  }

  record open-result {
    panel: u64,
    width: u32,
    height: u32,
  }

  record update-params {
    panel: u64,
    title: option<string>,
    status: option<string>,
    height: option<u32>,
    lines: option<list<panel-line>>,
  }

  open: func(params: open-params) -> result<open-result, error>;
  update: func(params: update-params) -> result<_, error>;
  focus: func(panel: u64) -> result<_, error>;
  close: func(panel: u64) -> result<_, error>;
}

interface diagnostics-publish {
  use types.{diagnostic, error};
  set: func(source: string, buffer: u64, revision: u64, items: list<diagnostic>) -> result<_, error>;
}

interface editor-decorations {
  use types.{decoration, error};
  set: func(buffer: u64, revision: u64, decorations: list<decoration>) -> result<_, error>;
}

interface editor-signs {
  use types.{error};
  record sign {
    line: u32,
    text: string,
    group: string,
  }
  set: func(buffer: u64, revision: u64, signs: list<sign>) -> result<_, error>;
}

interface ui-statusline {
  use types.{decoration-style, error};
  record statusline-segment {
    text: string,
    style: decoration-style,
    priority: u32,
  }
  set: func(segments: list<statusline-segment>) -> result<_, error>;
}

interface process-run {
  use types.{process-output, error};
  run: func(command: string, args: list<string>, timeout-ms: u32) -> result<process-output, error>;
}

interface process-jobs {
  use types.{error};

  enum stdin-mode {
    pipe,
    null,
  }

  enum job-signal {
    interrupt,
    terminate,
    kill,
  }

  enum job-stream {
    stdout,
    stderr,
  }

  enum job-state {
    running,
    exited,
    killed,
    failed,
  }

  record open-params {
    command: string,
    args: list<string>,
    cwd: option<string>,
    env: list<tuple<string, string>>,
    stdin: stdin-mode,
  }

  record job-status {
    state: job-state,
    exit-code: option<s32>,
    signal: option<s32>,
  }

  record job-output {
    job: u64,
    channel: job-stream,
    data: string,
    truncated: bool,
  }

  record job-exited {
    job: u64,
    state: job-state,
    exit-code: option<s32>,
    signal: option<s32>,
  }

  variant job-event {
    output(job-output),
    exited(job-exited),
  }

  open: func(params: open-params) -> result<u64, error>;
  write: func(job: u64, data: string) -> result<_, error>;
  close-stdin: func(job: u64) -> result<_, error>;
  signal: func(job: u64, signal: job-signal) -> result<_, error>;
  kill: func(job: u64) -> result<_, error>;
  status: func(job: u64) -> result<job-status, error>;
  poll: func(job: u64) -> result<list<job-event>, error>;
}

interface lifecycle {
  use types.{argument, error, event};
  init: func(host-protocol: u32) -> result<_, error>;
  invoke-command: func(id: string, args: list<argument>) -> result<argument, error>;
  on-event: func(event: event);
}

world host {
  import editor-read;
  import editor-write;
  import editor-buffers;
  import editor-buffers-write;
  import editor-windows;
  import editor-control;
  import options-read;
  import editor-execute;
  import config-read;
  import ui-message;
  import ui-prompt;
  import ui-progress;
  import diagnostics-publish;
  import editor-decorations;
  import editor-signs;
  import ui-statusline;
  import ui-panel;
  import process-run;
  import process-jobs;
  export lifecycle;
}
